# MotorGuard Environment Configuration
# Copy this file to .env and fill in your values

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# ─── Database ─────────────────────────────────────────────────────────────────
# For production (PostgreSQL)
DATABASE_URL=postgresql://motorguard:password@localhost:5432/motorguard

# For development (SQLite — use this if you don't have Postgres installed)
# DATABASE_URL=sqlite:./motorguard.db?mode=rwc

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=30

# ─── SMS / OTP Provider ────────────────────────────────────────────────────────
# Twilio (or any SMS provider)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15551234567

# ─── Maps API ─────────────────────────────────────────────────────────────────
# Mapbox or OpenStreetMap tile server
MAPBOX_TOKEN=pk.eyJxxxxxxxxxxxxxxxxxxx
MAP_TILE_URL=https://api.mapbox.com/styles/v1/mapbox/streets-v12/tiles

# ─── Push Notifications ───────────────────────────────────────────────────────
FCM_SERVER_KEY=your_firebase_server_key
APNS_KEY_ID=your_apns_key_id
APNS_TEAM_ID=your_apns_team_id

# ─── Emergency ────────────────────────────────────────────────────────────────
# Set to "true" ONLY in production to send real emergency messages
ENABLE_REAL_SOS=false
SOS_DEV_PHONE=+15550000000

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
OTP_RATE_LIMIT_PER_HOUR=5

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=debug
